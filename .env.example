# 复制为 .env 后填写：cp .env.example .env

# 必填：JWT 签名密钥，至少 32 位。生成：openssl rand -hex 32
JWT_SECRET=

# 可选：是否允许自助注册（首个管理员不受限制）。公网部署建议设为 false，
# 其他家庭成员通过「邀请码」加入。
ALLOW_REGISTRATION=true

# 可选：媒体存储配额（GB），默认 20
MEDIA_QUOTA_GB=20

# 可选：镜像来源，默认 yysdaddy/kidslog:0.6.5（预构建，不本地构建）
# 换版本：KIDSLOG_IMAGE=yysdaddy/kidslog:latest
# 换 GHCR：KIDSLOG_IMAGE=ghcr.io/yysdaddy/kidslog:0.6.5
# 本地构建产物标签：KIDSLOG_LOCAL_IMAGE=kidslog:local
# KIDSLOG_IMAGE=yysdaddy/kidslog:0.6.5

# 可选：时区
TZ=Asia/Shanghai
