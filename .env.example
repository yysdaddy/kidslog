# 复制为 .env 后填写：cp .env.example .env

# JWT 签名密钥，至少 32 位。生成：openssl rand -hex 32
# 使用 docker-compose.yml 时必填（缺失会直接报错）；使用 docker-compose.noenv.yml 时留空即可，
# 服务会自动生成到 ./data/.jwt_secret（0600）并在重启后沿用。
JWT_SECRET=

# 可选：是否允许自助注册（首个管理员不受限制）。公网部署建议设为 false，
# 其他家庭成员通过「邀请码」加入。
ALLOW_REGISTRATION=true

# 可选：媒体存储配额（GB），默认 20
MEDIA_QUOTA_GB=20

# 可选：镜像来源，默认 yysdaddy/kidslog:0.6.7（预构建，不本地构建）
# 换版本：KIDSLOG_IMAGE=yysdaddy/kidslog:latest
# 换 GHCR：KIDSLOG_IMAGE=ghcr.io/yysdaddy/kidslog:0.6.7
# 本地构建产物标签：KIDSLOG_LOCAL_IMAGE=kidslog:local
# KIDSLOG_IMAGE=yysdaddy/kidslog:0.6.7

# 可选：时区
TZ=Asia/Shanghai

# 可选：登录/注册/邀请码加入的限流阈值（每 IP 每分钟次数，0 表示关闭该接口限流）
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_REGISTER=5
# RATE_LIMIT_JOIN=10
# 是否信任 X-Forwarded-For（限流按真实客户端 IP 分桶）。默认开启；
# 若容器端口直接暴露在公网、前面没有反代，请设为 false，避免被伪造 IP 绕过限流。
# TRUST_PROXY=false
